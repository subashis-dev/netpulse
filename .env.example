# ==============================================================================
# NetPulse Configuration Template (.env.example)
# Copy this file to .env on each machine: cp .env.example .env
# ==============================================================================

# Docker Hub Image Repository
NETPULSE_IMAGE=ilegend44/netpulse:latest

# ------------------------------------------------------------------------------
# Security Pre-Shared Authentication Key (NETPULSE_AUTH_TOKEN)
# Must match across your Central Hub and all Mini PC Agents.
#
# How to generate a secure random token:
#   Python (Cross-platform) : python -c "import secrets; print(secrets.token_hex(24))"
#   Linux / macOS / WSL     : openssl rand -hex 24
#   Windows PowerShell      : [System.Guid]::NewGuid().ToString("N")
# ------------------------------------------------------------------------------
NETPULSE_AUTH_TOKEN=your_generated_secret_token_here

# Machine Role: "hub" on your primary machine, "agent" on all secondary Mini PCs
NODE_MODE=agent

# Identifying Machine Label (e.g. LivingRoom-MiniPC, Office-NUC, Rack-Server)
NODE_NAME=MiniPC-01

# Primary Hub IP & Port (required when NODE_MODE=agent)
HUB_URL=http://<PRIMARY_HUB_IP>:8990

# Network Listening Port (default: 8990)
PORT=8990

# Telemetry heartbeat interval in seconds (default: 2)
HEARTBEAT_INTERVAL=2

# Optional: VirusTotal v3 API Key for automated binary SHA-256 cloud reputation checks
VIRUSTOTAL_API_KEY=
